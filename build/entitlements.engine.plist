<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only with a Developer ID (hardened runtime), for Contents/Resources/engine/* (build/sign-mac.js). -->
<!-- No DYLD environment entitlement: app/platform.js gives the engine a minimal env with no DYLD_* variables. -->
<plist version="1.0">
<dict>
  <!-- The engine loads the user's own Homebrew libdvdcss/libaacs, which aren't signed by us. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
